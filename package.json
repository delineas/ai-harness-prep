{
  "name": "netflix-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "fetch-catalog": "node scripts/fetch-catalog.ts",
    "dev:api": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "e2e": "playwright test",
    "start": "node src/main.ts",
    "verify": "npm run typecheck && npm run test && npm run build && npm run e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
